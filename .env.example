# Kopiera till .env (som aldrig checkas in) och fyll i.
# Nycklar skapas i Associates Central → Tools → Creators API → Create Application → Add New Credential.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Versionen står vid nyckeln i Associates Central. Europa är 2.2 eller 3.2.
AMAZON_CREDENTIAL_VERSION=3.2
# Ditt Associates-ID för amazon.se (ersätter partnerTag i site.config.json)
AMAZON_PARTNER_TAG=
