{
  "name": "gearwise",
  "version": "1.0.0",
  "private": true,
  "description": "Statisk affiliate-sajt för teknik och gadgets med länkar till Amazon.se",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "fetch": "node scripts/fetch-amazon.mjs",
    "find": "node scripts/find-asin.mjs",
    "refresh": "node scripts/fetch-amazon.mjs && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "images": "node scripts/make-images.mjs",
    "test": "node --test test/*.test.mjs",
    "share": "node scripts/make-share.mjs"
  }
}
